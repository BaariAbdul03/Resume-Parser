# ==============================================================================
# SynapseCV Enterprise Environment Configuration Template
# Copy this file to `.env` in the root directory and supply your actual keys.
# DO NOT commit your `.env` file containing secret keys to Git.
# ==============================================================================

# Flask Settings
FLASK_APP=run.py
FLASK_ENV=development
# Production requires a custom, non-default value:
SECRET_KEY=generate_a_random_secure_secret_key_here

# Google Gemini API Credentials
# Get your Gemini API Key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_actual_gemini_api_key_here
# Optional Gemini overrides (defaults shown):
# GEMINI_MODEL=gemini-2.5-flash-preview-05-20
# GEMINI_FALLBACK_MODEL=gemini-2.0-flash
# GEMINI_RETRIES=2
# GEMINI_TIMEOUT=30.0

# Groq API Credentials (primary AI provider)
# Get your Groq API Key from: https://console.groq.com/keys
GROQ_API_KEY=your_actual_groq_api_key_here

# Database Settings
# Defaults to local SQLite file: instance/synapsecv.db
# For PostgreSQL (Supabase/Neon), uncomment and specify:
# DATABASE_URL=postgresql://user:password@host:port/dbname

# CORS Settings
# Comma-separated list of allowed browser origins for the REST API.
# Leave empty for same-origin only (the default when the UI serves the API).
# CORS_ORIGINS=https://app.example.com

# OAuth Settings (Optional, for Google Sign-In)
# GOOGLE_CLIENT_ID=your_google_client_id_here
# GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# When true, production boot fails unless Google OAuth credentials are set:
# OAUTH_REQUIRED=false
